{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "city": {
          "default": "",
          "maxLength": 100,
          "title": "City",
          "type": "string"
        },
        "region": {
          "default": "",
          "maxLength": 100,
          "title": "Region",
          "type": "string"
        },
        "country": {
          "default": "",
          "maxLength": 100,
          "title": "Country",
          "type": "string"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "precision": {
          "default": "none",
          "enum": [
            "none",
            "city",
            "exact"
          ],
          "title": "Precision",
          "type": "string"
        },
        "source": {
          "const": "manual",
          "default": "manual",
          "title": "Source",
          "type": "string"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Photo": {
      "additionalProperties": false,
      "properties": {
        "photo_id": {
          "title": "Photo Id",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "exclusiveMinimum": 0,
          "maximum": 52428800,
          "title": "Byte Size",
          "type": "integer"
        },
        "mime_type": {
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic",
            "image/heif"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "captured_at_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured At Utc"
        },
        "captured_timezone": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured Timezone"
        },
        "captured_offset_minutes": {
          "anyOf": [
            {
              "maximum": 840,
              "minimum": -840,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Captured Offset Minutes"
        },
        "imported_at_utc": {
          "title": "Imported At Utc",
          "type": "string"
        },
        "source": {
          "default": "import",
          "enum": [
            "import",
            "camera",
            "mobile",
            "desktop_camera"
          ],
          "title": "Source",
          "type": "string"
        },
        "is_original": {
          "const": true,
          "default": true,
          "title": "Is Original",
          "type": "boolean"
        },
        "trashed_at_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trashed At Utc"
        }
      },
      "required": [
        "photo_id",
        "relative_path",
        "sha256",
        "byte_size",
        "mime_type",
        "imported_at_utc"
      ],
      "title": "Photo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "entry_id": {
      "title": "Entry Id",
      "type": "string"
    },
    "record_date": {
      "format": "date",
      "title": "Record Date",
      "type": "string"
    },
    "status": {
      "default": "skipped",
      "enum": [
        "recorded",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "primary_photo_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Photo Id"
    },
    "mood": {
      "default": "",
      "maxLength": 80,
      "title": "Mood",
      "type": "string"
    },
    "note": {
      "default": "",
      "maxLength": 20000,
      "title": "Note",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Tags",
      "type": "array"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "photos": {
      "items": {
        "$ref": "#/$defs/Photo"
      },
      "maxItems": 1000,
      "title": "Photos",
      "type": "array"
    },
    "created_at_utc": {
      "title": "Created At Utc",
      "type": "string"
    },
    "updated_at_utc": {
      "title": "Updated At Utc",
      "type": "string"
    }
  },
  "required": [
    "entry_id",
    "record_date",
    "created_at_utc",
    "updated_at_utc"
  ],
  "title": "Entry",
  "type": "object"
}
