{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DayFrame",
  "version": "1.1.0",
  "identifier": "app.dayframe.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop/ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "externalBin": ["binaries/dayframe-server"],
    "shortDescription": "用影像记录生活",
    "longDescription": "离线保存照片、日记、回忆与未来信件。",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "DayFrame",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
